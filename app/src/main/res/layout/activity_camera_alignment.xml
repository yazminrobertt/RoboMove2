<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/robomove_white"
    android:padding="20dp">

    <!-- LEFT PANEL: Head Control -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Head Control"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/robomove_navy"
            android:layout_marginBottom="24dp"/>

        <!-- HORIZONTAL SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/robomove_white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↔  Horizontal"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/robomove_navy"
                    android:layout_marginBottom="16dp"/>

                <!-- Angle row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="Angle"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#555"/>

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="Left"
                        android:textSize="14sp"
                        android:textColor="#999"
                        android:gravity="center"/>

                    <SeekBar
                        android:id="@+id/seekHoriAngle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="160"
                        android:progress="80"/>

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="Right"
                        android:textSize="14sp"
                        android:textColor="#999"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvHoriAngleVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textColor="@color/robomove_navy"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="°"
                        android:textSize="17sp"
                        android:textColor="#888"/>
                </LinearLayout>

                <!-- Speed row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#555"/>

                    <View android:layout_width="44dp" android:layout_height="1dp"/>

                    <SeekBar
                        android:id="@+id/seekHoriSpeed"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="99"
                        android:progress="49"/>

                    <View android:layout_width="48dp" android:layout_height="1dp"/>

                    <TextView
                        android:id="@+id/tvHoriSpeedVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="50"
                        android:textSize="18sp"
                        android:textColor="@color/robomove_navy"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textSize="17sp"
                        android:textColor="#888"/>
                </LinearLayout>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHoriReset"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:text="Reset"
                        android:textSize="16sp"
                        android:backgroundTint="#FDD835"
                        android:textColor="@color/robomove_navy"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnHoriApply"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Apply"
                        android:textSize="16sp"
                        android:backgroundTint="@color/robomove_navy"
                        android:textColor="@color/robomove_white"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- VERTICAL SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/robomove_white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↕  Vertical"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/robomove_navy"
                    android:layout_marginBottom="16dp"/>

                <!-- Angle row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="Angle"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#555"/>

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="Up"
                        android:textSize="14sp"
                        android:textColor="#999"
                        android:gravity="center"/>

                    <SeekBar
                        android:id="@+id/seekVertiAngle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="23"
                        android:progress="3"/>

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="Down"
                        android:textSize="14sp"
                        android:textColor="#999"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvVertiAngleVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textColor="@color/robomove_navy"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="°"
                        android:textSize="17sp"
                        android:textColor="#888"/>
                </LinearLayout>

                <!-- Speed row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="Speed"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#555"/>

                    <View android:layout_width="44dp" android:layout_height="1dp"/>

                    <SeekBar
                        android:id="@+id/seekVertiSpeed"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="99"
                        android:progress="49"/>

                    <View android:layout_width="48dp" android:layout_height="1dp"/>

                    <TextView
                        android:id="@+id/tvVertiSpeedVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="50"
                        android:textSize="18sp"
                        android:textColor="@color/robomove_navy"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textSize="17sp"
                        android:textColor="#888"/>
                </LinearLayout>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnVertiReset"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:text="Reset"
                        android:textSize="16sp"
                        android:backgroundTint="#FDD835"
                        android:textColor="@color/robomove_navy"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnVertiApply"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Apply"
                        android:textSize="16sp"
                        android:backgroundTint="@color/robomove_navy"
                        android:textColor="@color/robomove_white"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CONTINUE BUTTON -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:text="Continue"
            android:textSize="20sp"
            android:backgroundTint="@color/robomove_teal"
            android:textColor="@color/robomove_white"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- RIGHT PANEL: Camera Preview -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/robomove_navy"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷  Kids Cam"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/robomove_white"
                android:layout_marginBottom="12dp"/>

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- NEW: shows what auto-align is doing / asking the child to do -->
            <TextView
                android:id="@+id/tvAutoAlignStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/robomove_white"
                android:gravity="center"/>

            <!-- NEW: Auto Align / Stop buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnAutoAlign"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Auto Align"
                    android:textSize="16sp"
                    android:backgroundTint="@color/robomove_teal"
                    android:textColor="@color/robomove_white"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnStopAutoAlign"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Stop"
                    android:enabled="false"
                    android:textSize="16sp"
                    android:backgroundTint="#D32F2F"
                    android:textColor="@color/robomove_white"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>